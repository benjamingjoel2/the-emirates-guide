---
import { CATEGORIES, EMIRATES, SITE } from '../data/site';
const { current } = Astro.props as { current?: string };
---
<header class="site-header">
  <div class="wrap bar">
    <a class="wordmark" href="/" aria-label={`${SITE.name}, home`}><small>Tourground</small>The Emirates Guide</a>
    <nav class="pillnav" aria-label="Main">
      <ul>
        <li><a href="/" aria-current={current === 'home' ? 'page' : undefined}>Home</a></li>
        {CATEGORIES.map((c) => <li><a href={`/${c.key}/`} aria-current={current === c.key ? 'page' : undefined}>{c.name}</a></li>)}
        <li><a href="/about/" aria-current={current === 'about' ? 'page' : undefined}>About</a></li>
      </ul>
    </nav>
    <div class="header-right">
      <a class="header-link" href={SITE.directoryUrl}>Find an operator</a>
      <details class="menu">
        <summary>Menu</summary>
        <div class="menu-panel" role="dialog" aria-modal="true" aria-label="Site menu">
          <div class="close"><button class="btn white" type="button" data-close>Close</button></div>
          <nav aria-label="Site menu">
            <ul class="main">
              <li><a href="/">Home</a></li>
              <li><a href="/stories/">All stories</a></li>
              {CATEGORIES.map((c) => <li><a href={`/${c.key}/`}>{c.name}</a></li>)}
              <li><a href="/about/">About</a></li>
            </ul>
            <ul class="sub" aria-label="Emirates">
              {EMIRATES.map((e) => <li><a href={`/destinations/${e.key}/`}>{e.name}</a></li>)}
            </ul>
            <p style="margin-top:28px"><a class="btn" href={SITE.directoryUrl}>Find a verified operator on Tourground</a></p>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>
<script>
  const d = document.querySelector<HTMLDetailsElement>('.menu');
  if (d) {
    const close = () => { d.open = false; document.body.style.overflow = ''; d.querySelector('summary')?.focus(); };
    d.addEventListener('toggle', () => {
      document.body.style.overflow = d.open ? 'hidden' : '';
      if (d.open) d.querySelector<HTMLElement>('[data-close]')?.focus();
    });
    d.querySelector('[data-close]')?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && d.open) close(); });
  }
</script>
