---
// Thin meridian-style arcs used behind heroes and the footer (decorative, hidden from assistive tech).
---
<svg class="lines" viewBox="0 0 1440 900" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <g fill="none" stroke="#fff" stroke-width="1" vector-effect="non-scaling-stroke">
    <ellipse cx="720" cy="450" rx="720" ry="640" />
    <ellipse cx="720" cy="450" rx="560" ry="640" />
    <ellipse cx="720" cy="450" rx="380" ry="640" />
    <ellipse cx="720" cy="450" rx="190" ry="640" />
    <line x1="720" y1="-200" x2="720" y2="1100" />
  </g>
</svg>
