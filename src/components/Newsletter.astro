---
import { Image } from 'astro:assets';
import PhotoCredit from './PhotoCredit.astro';
import { SITE } from '../data/site';
import { photo } from '../lib/photos';
const a = photo('ajman-corniche');
const b = photo('liwa-dune');
---
<section class="section" aria-label="Newsletter and trip planning">
  <div class="wrap panels">
    <div class="panel">
      <Image src={a.src} alt="" widths={[640, 1000]} sizes="(min-width: 900px) 50vw, 100vw" loading="lazy" format="webp" />
      <h2 id="nl-title">Sign up to our newsletter</h2>
      <p>New stories, and updates when rules change. Sent occasionally; unsubscribe at any time.</p>
      <form id="nl-form" class="nl-form" action={`mailto:${SITE.email}`} method="post" enctype="text/plain" novalidate aria-labelledby="nl-title">
        <label for="nl-email" class="visually-hidden">Email address</label>
        <input id="nl-email" name="email" type="email" autocomplete="email" required placeholder="Your email address" aria-describedby="nl-note" />
        <button class="btn" type="submit">Sign up</button>
      </form>
      <p id="nl-status" class="form-status" role="status" aria-live="polite"></p>
      <p id="nl-note" class="small">Signing up opens an email to {SITE.email} with your address, which you then send. See our <a href="/privacy/">privacy policy</a>.</p>
      <p class="credit"><PhotoCredit credit={a.credit} /></p>
    </div>
    <div class="panel">
      <Image src={b.src} alt="" widths={[640, 1000]} sizes="(min-width: 900px) 50vw, 100vw" loading="lazy" format="webp" />
      <h2>Book with a verified local operator</h2>
      <p>The Emirates Guide is published by Tourground, which runs a directory of verified local travel companies. When you are ready to book, start there.</p>
      <p><a class="btn" href={SITE.directoryUrl}>Find an operator on Tourground</a></p>
      <p class="small">See our <a href="/disclosure/">publisher disclosure</a>.</p>
      <p class="credit"><PhotoCredit credit={b.credit} /></p>
    </div>
  </div>
</section>
<script>
  const form = document.getElementById('nl-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = form.querySelector('input') as HTMLInputElement;
    const status = document.getElementById('nl-status')!;
    if (!input.value || !input.checkValidity()) {
      status.textContent = 'Please enter a valid email address.';
      input.setAttribute('aria-invalid', 'true');
      input.focus();
      return;
    }
    input.removeAttribute('aria-invalid');
    const to = form.action.replace('mailto:', '');
    const body = encodeURIComponent(`Please add ${input.value} to The Emirates Guide newsletter.`);
    window.location.href = `mailto:${to}?subject=${encodeURIComponent('Newsletter sign-up')}&body=${body}`;
    status.textContent = 'Your email app should open with the sign-up message ready to send.';
  });
</script>
