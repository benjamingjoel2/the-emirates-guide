---
import { Image } from 'astro:assets';
import { photo } from '../lib/photos';
import { categoryByKey, emirateByKey } from '../data/site';
import { formatDate, isoDate, postUrl, type Post } from '../lib/posts';
const { post, headingLevel = 3 } = Astro.props as { post: Post; headingLevel?: 2 | 3 };
const p = photo(post.data.hero);
const H = `h${headingLevel}` as 'h2' | 'h3';
const em = post.data.emirates;
const countries = em.length === 7 ? 'All seven emirates' : em.length > 3 ? `${em.slice(0, 2).map((k) => emirateByKey(k).name).join(', ')} +${em.length - 2}` : em.map((k) => emirateByKey(k).name).join(', ') || 'United Arab Emirates';
---
<a class="card-post__link" href={postUrl(post)}>
  <Image src={p.src} alt="" widths={[420, 640, 840]} sizes="(min-width: 1024px) 420px, 310px" loading="lazy" decoding="async" format="webp" />
  <ul class="card-post__pills">
    {post.data.advertisement && <li class="pill ad">Advertisement feature</li>}
    <li class="pill">{categoryByKey(post.data.category).name}</li>
  </ul>
  <span>
    <span class="card-post__countries">{countries}</span>
    <H class="card-post__name">{post.data.title}</H>
    <time class="card-post__date" datetime={isoDate(post.data.published)}>{formatDate(post.data.published)}</time>
  </span>
</a>
