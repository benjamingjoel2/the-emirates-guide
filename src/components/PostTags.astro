---
import { categoryByKey, emirateByKey } from '../data/site';
import type { Post } from '../lib/posts';
const { post, variant = 'pill', max = 2 } = Astro.props as { post: Post; variant?: 'pill' | 'outline' | 'dark'; max?: number };
const c = categoryByKey(post.data.category);
const tags = [
  ...(post.data.advertisement ? [{ name: 'Advertisement feature', href: '/disclosure/#advertising', ad: true }] : []),
  { name: c.name, href: `/${c.key}/`, ad: false },
  ...post.data.emirates.map((k) => ({ name: emirateByKey(k).name, href: `/destinations/${k}/`, ad: false })),
].slice(0, max + (post.data.advertisement ? 1 : 0));
---
<ul class="pills" aria-label="Topics">
  {tags.map((t) => <li><a class:list={['pill', { ad: t.ad, outline: !t.ad && variant === 'outline', dark: !t.ad && variant === 'dark' }]} href={t.href}>{t.name}</a></li>)}
</ul>
