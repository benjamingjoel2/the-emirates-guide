---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { CATEGORIES, EMIRATES, SITE } from '../../data/site';
import { allPosts, postUrl, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await allPosts();
  return CATEGORIES.map((c) => ({ params: { category: c.key }, props: { cat: c, posts: posts.filter((p) => p.data.category === c.key) } }));
}
const { cat, posts } = Astro.props as { cat: (typeof CATEGORIES)[number]; posts: Post[] };
const itemList = {
  '@type': 'CollectionPage',
  '@id': `${SITE.url}/${cat.key}/#page`,
  name: cat.name,
  description: cat.blurb,
  url: `${SITE.url}/${cat.key}/`,
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: { '@type': 'ItemList', itemListElement: posts.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}${postUrl(p)}`, name: p.data.title })) },
};
---
<Base title={cat.name} description={`${cat.blurb} From The Emirates Guide, published by Tourground.`} crumbs={[{ name: cat.name, path: `/${cat.key}/` }]} schema={[itemList]} current={cat.key}>
  <PageHero title={cat.name} eyebrow="The Emirates Guide" lede={cat.blurb} photoKey={cat.photo} />
  <section class="listing listing--black" aria-labelledby="list-title">
    <Crumbs items={[{ name: cat.name }]} />
    <div class="listing__head"><h2 class="listing__title" id="list-title">{posts.length} {posts.length === 1 ? 'story' : 'stories'}</h2><a class="action" href="/stories/">All stories <span class="arrow" aria-hidden="true">↗</span></a></div>
    <ul class="chips" style="max-width:1152px;margin:0 auto 24px" aria-label="Topics">{CATEGORIES.map((c) => <li><a href={`/${c.key}/`} aria-current={c.key === cat.key ? 'page' : undefined}>{c.name}</a></li>)}</ul>
    {cat.key === 'destinations' && <ul class="chips" style="max-width:1152px;margin:0 auto 32px" aria-label="Destinations by emirate">{EMIRATES.map((e) => <li><a href={`/destinations/${e.key}/`}>{e.name}</a></li>)}</ul>}
    {posts.length ? (
      <ul class="post-grid">{posts.map((p) => <li><PostCard post={p} headingLevel={3} /></li>)}</ul>
    ) : (
      <p>New stories in this section are on the way. In the meantime, browse <a href="/stories/">all stories</a>.</p>
    )}
  </section>
  <Newsletter />
</Base>
