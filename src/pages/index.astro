---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import PostTags from '../components/PostTags.astro';
import Newsletter from '../components/Newsletter.astro';
import PhotoCredit from '../components/PhotoCredit.astro';
import { CATEGORIES, EMIRATES, SITE } from '../data/site';
import { allPosts, formatDate, isoDate, postUrl, readingMinutes } from '../lib/posts';
import { photo } from '../lib/photos';

const posts = await allPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const startOrder = ['uae-first-timers-guide-seven-emirates', 'best-time-to-visit-uae-month-by-month', 'dubai-or-abu-dhabi-where-to-stay', 'five-day-uae-itinerary'];
const start = posts.filter((p) => p.data.startHere).sort((a, b) => startOrder.indexOf(a.id) - startOrder.indexOf(b.id));
const latest = posts.filter((p) => p.id !== featured.id).slice(0, 6);
const hero = photo(featured.data.hero);
const catPhoto: Record<string, string> = {
  destinations: 'dhayah-fort', itineraries: 'hatta-dam', 'desert-adventure': 'liwa-dune',
  'food-culture': 'spice-souk', 'where-to-stay': 'dubai-burj-ferry', 'travel-tips': 'al-fahidi',
};
---
<Base title={`${SITE.name}: Travel stories and guides to the UAE`} description={SITE.description}>
  <h1 class="visually-hidden">{SITE.name}: travel stories and guides to the United Arab Emirates</h1>
  <section class="hero" aria-labelledby="featured-title">
    <Image class="hero-img" src={hero.src} alt={featured.data.heroAlt} widths={[640, 1024, 1600]} sizes="100vw" loading="eager" fetchpriority="high" format="webp" />
    <div class="wrap hero-inner">
      <p class="visually-hidden">Featured story</p>
      <PostTags post={featured} light max={2} />
      <a class="hero-link" href={postUrl(featured)}><h2 id="featured-title" class="hero-title">{featured.data.title}</h2></a>
      <p class="dek">{featured.data.description}</p>
      <p class="meta"><time datetime={isoDate(featured.data.published)}>{formatDate(featured.data.published)}</time> · {readingMinutes(featured)} min read</p>
    </div>
    <p class="credit"><PhotoCredit credit={hero.credit} /></p>
  </section>

  <section class="band mission" aria-label="About The Emirates Guide">
    <p>Story-led, practical guides to the seven emirates: where to go, when to go, what it is really like, and how to book safely.</p>
    <a class="btn" href="/about/">How we work</a>
  </section>

  <section class="section" aria-labelledby="start-title">
    <div class="wrap">
      <div class="section-head"><h2 id="start-title">Start here</h2></div>
      <p class="lede" style="margin:-12px 0 22px">First time in the UAE? Read these four in order.</p>
      <ol class="start">
        {start.map((p) => <li><a href={postUrl(p)}><span>{p.data.title}</span></a></li>)}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="latest-title">
    <div class="wrap">
      <div class="section-head"><h2 id="latest-title">Latest stories</h2><a href="/stories/">View all</a></div>
      <ul class="grid three">
        {latest.map((p) => <li><PostCard post={p} /></li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="cats-title">
    <div class="wrap">
      <div class="section-head"><h2 id="cats-title">Explore by topic</h2></div>
      <ul class="tiles">
        {CATEGORIES.map((c) => {
          const ph = photo(catPhoto[c.key]);
          return <li class="tile"><a href={`/${c.key}/`}><Image src={ph.src} alt="" widths={[360, 640]} sizes="(min-width: 900px) 33vw, 50vw" loading="lazy" format="webp" /><span>{c.name}</span></a></li>;
        })}
      </ul>
      <h3 class="visually-hidden">Emirates</h3>
      <ul class="chips-nav" style="margin-top:24px" aria-label="Destinations by emirate">
        {EMIRATES.map((e) => <li><a href={`/destinations/${e.key}/`}>{e.name}</a></li>)}
      </ul>
    </div>
  </section>

  <Newsletter />
</Base>
