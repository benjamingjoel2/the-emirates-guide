---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Lines from '../components/Lines.astro';
import Newsletter from '../components/Newsletter.astro';
import Magazine from '../components/Magazine.astro';
import { CATEGORIES, EMIRATES, SITE, categoryByKey, emirateByKey } from '../data/site';
import { allPosts, postUrl } from '../lib/posts';
import { photo } from '../lib/photos';

const posts = await allPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const startOrder = ['uae-first-timers-guide-seven-emirates', 'best-time-to-visit-uae-month-by-month', 'dubai-or-abu-dhabi-where-to-stay', 'five-day-uae-itinerary'];
const start = posts.filter((p) => p.data.startHere).sort((a, b) => startOrder.indexOf(a.id) - startOrder.indexOf(b.id));
const hero = photo(featured.data.hero);
const intro = photo('musandam-dhow');
const cta = photo('jebel-jais-sunset');
const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'].map((n, i) => {
  const s = i >= 5 && i <= 8 ? 'hot' : i === 4 || i === 9 ? 'mid' : 'cool';
  return { n, s, label: s === 'hot' ? 'Hot and humid' : s === 'mid' ? 'In between' : 'Most pleasant' };
});
const counts = Object.fromEntries(CATEGORIES.map((c) => [c.key, posts.filter((p) => p.data.category === c.key).length]));
const places = (em: string[]) => em.length === 7 ? 'All seven emirates' : em.length > 3 ? `${em.slice(0, 2).map((k) => emirateByKey(k).name).join(', ')} +${em.length - 2}` : em.map((k) => emirateByKey(k).name).join(', ') || 'United Arab Emirates';
---
<Base title={`${SITE.name}: Travel stories and guides to the UAE`} description={SITE.description} current="home">
  <header class="header">
    <Image class="header__media" src={hero.src} alt={featured.data.heroAlt} widths={[640, 1024, 1600, 2000]} sizes="100vw" loading="eager" fetchpriority="high" format="webp" />
    <div class="header__shade"></div>
    <Lines />
    <div class="header__center">
      <h1 class="visually-hidden">{SITE.name}: travel stories and guides to the United Arab Emirates</h1>
      <p aria-hidden="false">
        <span class="header__suptitle">Featured story</span>
        <span class="header__name">{featured.data.title}</span>
      </p>
      <a class="action" href={postUrl(featured)}>Read the story <span class="arrow" aria-hidden="true">↗</span><span class="visually-hidden">: {featured.data.title}</span></a>
    </div>
    <p class="header__label">Photo: <a href={hero.credit.source}>{hero.credit.author}</a> · <a href={hero.credit.licenseUrl}>{hero.credit.license}</a></p>
  </header>

  <section class="introduction" aria-labelledby="journey-title">
    <div class="introduction__left">
      <p class="introduction__mark">The Emirates Guide</p>
      <p class="introduction__text">Seven emirates, two coastlines, mountains, dunes and old trading towns. We write story-led, practical guides to all of it, check every rule against official sources, and point you to verified local operators when you are ready to book.</p>
    </div>
    <div class="introduction__right">
      <Image src={intro.src} alt="" widths={[640, 1000]} sizes="(min-width: 1024px) 50vw, 100vw" loading="lazy" format="webp" />
      <h2 class="introduction__title" id="journey-title">Start here: your first UAE trip</h2>
      <ol class="steps">
        {start.map((p, i) => <li><a href={postUrl(p)}><span class="steps__n">0{i + 1}</span><span class="steps__t"><span class="steps__cat">{categoryByKey(p.data.category).name}</span>{p.data.title}</span></a></li>)}
        <li><a href={SITE.directoryUrl}><span class="steps__n">0{start.length + 1}</span><span class="steps__t"><span class="steps__cat">Booking</span>Book with a verified local operator</span></a></li>
      </ol>
      <p class="introduction__credit"><a href={intro.credit.source}>Photo: {intro.credit.author} · {intro.credit.license}</a></p>
    </div>
  </section>

  <section class="circuits" aria-labelledby="stories-title">
    <h2 class="circuits__title" id="stories-title">Our stories</h2>
    <ul class="circuits__tabs" role="tablist" aria-label="Filter stories by topic">
      <li role="presentation"><a class="circuits__tab" role="tab" aria-selected="true" data-cat="all" href="/stories/">All <span class="circuits__count">{posts.length}</span></a></li>
      {CATEGORIES.map((c) => <li role="presentation"><a class="circuits__tab" role="tab" aria-selected="false" data-cat={c.key} href={`/${c.key}/`}>{c.name} <span class="circuits__count">{counts[c.key]}</span></a></li>)}
    </ul>
    <div class="coverflow" data-coverflow>
      <ul class="coverflow__track">
        {posts.map((p) => {
          const ph = photo(p.data.hero);
          return (
            <li class="cf-card" data-cat={p.data.category}>
              <a class="cf-card__link" href={postUrl(p)}>
                <span class="cf-card__img">
                  <Image src={ph.src} alt="" widths={[600, 900, 1500]} sizes="(min-width: 1024px) 750px, 86vw" loading="lazy" format="webp" />
                  <span class="cf-card__content">
                    <span class="cf-card__header">
                      {p.data.startHere && <span class="badge-new">Start here</span>}
                      <span class:list={['badge-type', { ad: p.data.advertisement }]}>{p.data.advertisement ? 'Advertisement feature' : categoryByKey(p.data.category).name}</span>
                    </span>
                    <span class="cf-card__main">
                      <span class="cf-card__destinations">{places(p.data.emirates)}</span>
                      <span class="cf-card__name">{p.data.title}</span>
                    </span>
                  </span>
                </span>
                <span class="cf-card__strip" aria-hidden="true"><i>{places(p.data.emirates)}</i>{p.data.title}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
    <div class="coverflow__nav">
      <button class="round-btn" type="button" data-cf-prev aria-label="Previous story">←</button>
      <button class="round-btn" type="button" data-cf-next aria-label="Next story">→</button>
    </div>
  </section>

  <section class="em-index" aria-labelledby="em-index-title">
    <div class="em-index__aside">
      <p class="em-index__label">Destinations</p>
      <h2 class="em-index__title" id="em-index-title">Seven emirates, one by one</h2>
      <p class="em-index__desc">From the capital's island city to the mountains above the Gulf of Oman. Pick an emirate for what it is like and our stories about it.</p>
      <a class="action" href="/destinations/">All destinations <span class="arrow" aria-hidden="true">↗</span></a>
    </div>
    <ol class="em-index__list">
      {EMIRATES.map((e, i) => {
        const ph = photo(e.photo);
        return (
          <li>
            <a class="em-row" href={`/destinations/${e.key}/`}>
              <span class="em-row__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="em-row__body"><span class="em-row__name">{e.name}</span><span class="em-row__intro">{e.intro.split('. ')[0]}.</span></span>
              <Image class="em-row__img" src={ph.src} alt="" widths={[200, 400]} sizes="160px" loading="lazy" format="webp" />
            </a>
          </li>
        );
      })}
    </ol>
  </section>

  <section class="fullwidth" aria-labelledby="cta-title">
    <Image src={cta.src} alt="" widths={[640, 1024, 1600, 2000]} sizes="100vw" loading="lazy" format="webp" />
    <h2 class="fullwidth__title" id="cta-title">Plan with people who know the ground</h2>
    <p class="fullwidth__description">Every story ends with a pointer to a verified local operator. Tourground, our publisher, lists them by destination, so you can ask the questions that matter before you book.</p>
    <a class="action" href={SITE.directoryUrl}>Find a verified UAE operator <span class="arrow" aria-hidden="true">↗</span></a>
    <p class="header__label">Jebel Jais, Ras Al Khaimah<br />Photo: <a href={cta.credit.source}>{cta.credit.author}</a> · <a href={cta.credit.licenseUrl}>{cta.credit.license}</a></p>
  </section>

  <section class="seasons" aria-labelledby="seasons-title">
    <div class="seasons__head">
      <h2 class="seasons__title" id="seasons-title">The year at a glance</h2>
      <p class="seasons__sub">When the UAE is at its most comfortable, according to the official Abu Dhabi tourism board</p>
    </div>
    <ol class="seasons__months">
      {MONTHS.map((m) => <li class:list={['seasons__m', `is-${m.s}`]}><span class="seasons__name">{m.n}</span><span class="seasons__state">{m.label}</span></li>)}
    </ol>
    <div class="seasons__legend">
      <p><span class="dot is-cool"></span>November to April: the most pleasant months (<a href="https://visitabudhabi.ae/en/plan-your-trip/essential-info/climate-and-what-to-wear">Visit Abu Dhabi</a>)</p>
      <p><span class="dot is-hot"></span>June to September: intense heat and high humidity (<a href="https://visitabudhabi.ae/en/plan-your-trip/essential-info/weather-in-abu-dhabi/summer">Visit Abu Dhabi</a>)</p>
      <p><span class="dot is-mid"></span>May and October: between the two</p>
    </div>
    <p style="margin-top:28px"><a class="action" href="/stories/best-time-to-visit-uae-month-by-month/">Month by month guide <span class="arrow" aria-hidden="true">↗</span></a></p>
  </section>

  <Magazine exclude={featured.id} />
  <section class="principles" aria-labelledby="principles-title">
    <p class="em-index__label">How we work</p>
    <h2 class="principles__title" id="principles-title">Written to be trusted</h2>
    <ol class="principles__list">
      <li><span class="principles__n">01</span><h3>Sourced</h3><p>Visa rules, dress codes, opening arrangements and Ramadan hours link to the official source where they appear, and every story lists its sources.</p></li>
      <li><span class="principles__n">02</span><h3>Dated</h3><p>Every story shows when it was published and when its facts were last checked. Rules change, so we tell you to check before you go.</p></li>
      <li><span class="principles__n">03</span><h3>Nothing invented</h3><p>No made-up reviews, quotes, prices or statistics. If we cannot source it, we leave it out. Paid content is always labelled "Advertisement feature".</p></li>
    </ol>
    <a class="principles__link" href="/about/">Read more about us and our publisher, Tourground</a>
  </section>

  <Newsletter />
</Base>

<script>
  // Coverflow carousel with category tabs (progressive enhancement over a scrollable list).
  const cf = document.querySelector<HTMLElement>('[data-coverflow]');
  if (cf) {
    const cards = [...cf.querySelectorAll<HTMLElement>('.cf-card')];
    const prev = document.querySelector<HTMLButtonElement>('[data-cf-prev]')!;
    const next = document.querySelector<HTMLButtonElement>('[data-cf-next]')!;
    let visible = cards.slice();
    let active = 0;
    const layout = () => {
      const w = cards[0].offsetWidth;
      const step = Math.min(300, w * 0.4);
      visible.forEach((c, i) => {
        const d = i - active, a = Math.abs(d);
        const s = Math.max(0.6, 1 - 0.1 * a);
        c.style.transform = `translateX(calc(-50% + ${d * step}px)) translateY(${(1 - s) * w * 0.3}px) scale(${s})`;
        c.style.zIndex = String(100 - a);
        c.style.opacity = a > 3 ? '0' : '1';
        c.classList.toggle('is-active', d === 0);
        c.classList.toggle('is-right', d > 0);
        const link = c.querySelector('a')!;
        if (d === 0) link.removeAttribute('tabindex'); else link.setAttribute('tabindex', '-1');
        c.setAttribute('aria-hidden', d === 0 ? 'false' : 'true');
      });
      prev.disabled = active === 0; next.disabled = active >= visible.length - 1;
    };
    cf.classList.add('ready');
    cards.forEach((c, i) => c.addEventListener('click', (e) => {
      const idx = visible.indexOf(c);
      if (idx !== active) { e.preventDefault(); active = idx; layout(); }
    }));
    prev.addEventListener('click', () => { active = Math.max(0, active - 1); layout(); });
    next.addEventListener('click', () => { active = Math.min(visible.length - 1, active + 1); layout(); });
    let x0: number | null = null;
    cf.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    cf.addEventListener('touchend', (e) => { if (x0 === null) return; const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) { active = Math.min(visible.length - 1, Math.max(0, active + (dx < 0 ? 1 : -1))); layout(); } x0 = null; });
    document.querySelectorAll<HTMLAnchorElement>('.circuits__tab').forEach((tab) => tab.addEventListener('click', (e) => {
      e.preventDefault();
      document.querySelectorAll('.circuits__tab').forEach((t) => t.setAttribute('aria-selected', 'false'));
      tab.setAttribute('aria-selected', 'true');
      const cat = tab.dataset.cat;
      cards.forEach((c) => { c.hidden = !(cat === 'all' || c.dataset.cat === cat); });
      visible = cards.filter((c) => !c.hidden);
      active = 0; layout();
    }));
    window.addEventListener('resize', layout);
    layout();
  }
</script>
