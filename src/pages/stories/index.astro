---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import PageHero from '../../components/PageHero.astro';
import Newsletter from '../../components/Newsletter.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES, SITE } from '../../data/site';
import { allPosts, postUrl } from '../../lib/posts';
const posts = await allPosts();
const page = {
  '@type': 'CollectionPage', '@id': `${SITE.url}/stories/#page`, name: 'All stories', url: `${SITE.url}/stories/`,
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: { '@type': 'ItemList', itemListElement: posts.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}${postUrl(p)}`, name: p.data.title })) },
};
---
<Base title="All stories" description="Every story on The Emirates Guide: destinations, itineraries, desert trips, food and culture, where to stay and travel tips for the UAE." crumbs={[{ name: 'All stories', path: '/stories/' }]} schema={[page]}>
  <PageHero title="The Emirates Guide stories" eyebrow="Everything we have published" lede="Story-led, practical guides to the seven emirates, newest first. Every fact that can change links to its official source." photoKey="dubai-creek-abras" />
  <nav class="tabs" aria-label="Topics">
    <ul>{CATEGORIES.map((c) => <li><a href={`/${c.key}/`}>{c.name}</a></li>)}</ul>
  </nav>
  <div class="wrap"><Crumbs items={[{ name: 'All stories' }]} /></div>
  <section class="section" aria-label="Stories">
    <div class="wrap">
      <ul class="grid three">{posts.map((p) => <li><PostCard post={p} headingLevel={2} /></li>)}</ul>
    </div>
  </section>
  <Newsletter />
</Base>
