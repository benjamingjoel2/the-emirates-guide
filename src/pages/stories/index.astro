---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import PageHero from '../../components/PageHero.astro';
import Newsletter from '../../components/Newsletter.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES, SITE } from '../../data/site';
import { allPosts, postUrl } from '../../lib/posts';
const posts = await allPosts();
const page = {
  '@type': 'CollectionPage', '@id': `${SITE.url}/stories/#page`, name: 'All stories', url: `${SITE.url}/stories/`,
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: { '@type': 'ItemList', itemListElement: posts.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}${postUrl(p)}`, name: p.data.title })) },
};
---
<Base title="All stories" description="Every story on The Emirates Guide: destinations, itineraries, desert trips, food and culture, where to stay and travel tips for the UAE." crumbs={[{ name: 'All stories', path: '/stories/' }]} schema={[page]}>
  <PageHero title="The Emirates Guide blog" eyebrow="Story-led and sourced" lede="Where to go, when to go, what it is really like, and how to book safely. Every fact that can change links to its official source." photoKey="dubai-creek-abras" />
  <section class="listing listing--black" aria-labelledby="list-title">
    <Crumbs items={[{ name: 'All stories' }]} />
    <div class="listing__head"><h2 class="listing__title" id="list-title">All stories</h2></div>
    <ul class="chips" style="max-width:1152px;margin:0 auto 32px" aria-label="Topics">{CATEGORIES.map((c) => <li><a href={`/${c.key}/`}>{c.name} ({posts.filter((p) => p.data.category === c.key).length})</a></li>)}</ul>
    <ul class="post-grid">{posts.map((p) => <li><PostCard post={p} headingLevel={3} /></li>)}</ul>
  </section>
  <Newsletter />
</Base>
